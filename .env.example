# Backend env variables — bunları .env'ye kopyala ve doldur.
# (Mevcut .env'ne dokunmadım, buradan ekleyebilirsin)

# Gemini / Google AI Studio API key
# OPSİYONEL: Uygulama BYOK (Bring Your Own Key) modunda çalışır — her kullanıcı
# kendi Gemini anahtarını arayüzden girer. Sunucunun kendi anahtarı kullanıcı
# isteklerinde KULLANILMAZ. Bu değer yalnızca opsiyonel "ortak varsayılan FAISS
# hafızası"nı yüklemek için bakılır; boş bırakabilirsin.
GOOGLE_API_KEY=

# Admin hesabı
# ADMIN_PASSWORD'ü BOŞ bırakırsan startup'ta rastgele güçlü bir şifre üretilir ve
# konsola bir kez yazdırılır. Üretimde KENDİ güçlü şifreni gir — burada paylaşılan
# sabit bir şifre KULLANMA.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@lostick.local

# ─── Google OAuth ──────────────────────────────────────────────
# Frontend'deki NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID ile AYNI değer olmalı
# (Google ID token verify ederken backend bunu kontrol eder)
GOOGLE_OAUTH_CLIENT_ID=

# ─── GitHub OAuth ──────────────────────────────────────────────
# GitHub Developer Settings → New OAuth App'te alacaksın
# Callback URL: http://localhost:3000/login/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── CORS (Cross-Origin Resource Sharing) ──────────────────────
# Backend'e tarayıcıdan istek atabilecek frontend domain'lerini KESİN olarak listele.
# Boş bırakırsan dev ortamda localhost:3000/3001 default'u kullanılır.
# Üretimde (APP_ENV=production) TANIMSIZSA sunucu açılmaz — güvenlik için fail-fast.
#
# ❌ ASLA "*" kullanma — credentials ile birlikte güvensizdir, sessizce drop edilir.
# ✅ Virgülle ayır, trailing slash KOYMA:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Vercel preview gibi dinamik subdomain'ler için opsiyonel regex:
# ALLOWED_ORIGIN_REGEX=^https://lostick-[a-z0-9-]+\.vercel\.app$

# Ortam tipi: "production" → CORS env'i zorunlu hale gelir, dev fallback'i devre dışı
APP_ENV=development

# ─── DATABASE (PostgreSQL in production, SQLite for dev) ───────
# Tanımlıysa db_pool otomatik PG'ye geçer (psycopg2 ile, connection pool 30/15).
# Tanımsızsa SQLite dosyaları (kullanim_cache.db + gorsel_cache.db) kullanılır.
#
# Migration: önce DATABASE_URL'ü set et, sonra `python migrate_to_postgres.py` çalıştır.
# Script idempotent — verileri kopyalar + autoincrement sequence'leri reset eder.
#
# DATABASE_URL=postgresql://kullanici:sifre@hosturl:5432/lostick

# ─── REDIS (Multi-Worker Background Jobs — RQ) ─────────────────
# Tanımlıysa background job'lar (konu anlatımı, kart üretimi, vb.) RQ kuyruğuna
# enqueue edilir → AYRI bir process'te (rq worker) çalışır → multi-worker güvenli.
# Tanımsızsa mevcut in-process threading fallback'i devreye girer (single-worker only).
#
# Üretim deploy'unda:
#   docker run -d --name redis redis:7-alpine
#   # Web process:
#   uvicorn main:app --workers 4
#   # Ayrı worker process(ler)i:
#   rq worker --url $REDIS_URL lostick
#
# REDIS_URL=redis://localhost:6379/0
# RQ_QUEUE_NAME=lostick   # opsiyonel, default "lostick"

# ─── E-POSTA GÖNDERİMİ (Doğrulama + Şifre Sıfırlama) ───────────
# Bulut sağlayıcıları (AWS, GCP, DigitalOcean, Vercel, Render…) Port 25/465/587'yi
# çoğunlukla bloklar. Üretimde TRANSACTIONAL EMAIL API'sini kullan (SendGrid/Mailgun/SES).
# Bu sayede mailler bloklanmaz ve sağlayıcının DKIM/SPF altyapısı ile Spam'e düşmez.
#
# Provider'ı açıkça belirt (tercih edilen) veya boş bırakıp env'lerden auto-detect:
#   EMAIL_PROVIDER=sendgrid    # veya: mailgun, ses, smtp, console
#
# Tanımsızsa otomatik tespit: SENDGRID_API_KEY > MAILGUN_* > AWS_SES_REGION > SMTP_* > console

# Ortak gönderici kimliği — tüm provider'lar için (DKIM kaydının olduğu domain olmalı)
EMAIL_FROM=noreply@lostick.ai
EMAIL_FROM_NAME=Lostick AI

# Seçenek 1: SendGrid (önerilen — basit API, geniş limit, ücretsiz tier 100/gün)
# https://app.sendgrid.com/settings/api_keys → "Mail Send" yetkisi yeterli
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Seçenek 2: Mailgun (us veya eu region)
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.lostick.ai
# MAILGUN_REGION=us               # veya: eu

# Seçenek 3: AWS SES (boto3 ile — IAM role veya AWS_ACCESS_KEY_ID/SECRET env'inden alır)
# AWS_SES_REGION=eu-central-1

# Seçenek 4: SMTP (self-hosted veya Gmail App Password — bulut sağlayıcılarda port'lar bloklu olabilir)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Seçenek 5 (dev): hiçbir provider tanımlama → kod sunucu konsoluna yazılır

# ─── TRUSTED PROXIES (Rate Limit IP Spoofing Koruması) ─────────
# X-Forwarded-For / CF-Connecting-IP header'larına SADECE bu listedeki IP'lerden
# gelen istekler için güvenilir. Aksi halde saldırgan kendi header'ını uydurup
# rate limit'i bypass edebilir veya başkasını banlayabilir.
#
# Cloudflare arkasındaysanız → https://www.cloudflare.com/ips/ listesini ekle
# AWS ALB arkasındaysanız → VPC CIDR'ı
# Tek host (Nginx aynı makinede) → 127.0.0.1,::1
# Hiçbir proxy yoksa → tanımsız bırak (header'lar yok sayılır, socket IP kullanılır)
#
# APP_ENV=production + TRUSTED_PROXIES tanımsız → loud uyarı verir (fail-fast değil,
# çünkü "doğrudan internete açık tek host" da geçerli)
TRUSTED_PROXIES=127.0.0.1,::1
# Cloudflare örneği:
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# ─── SENTRY (Hata İzleme + APM) ────────────────────────────────
# Üretimde unhandled exception'lar ve 5xx'ler Sentry'ye gönderilir.
# DSN tanımsızsa Sentry devre dışı (dev için normal).
#
# https://sentry.io → Project Settings → Client Keys → DSN'i kopyala
# SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/YYYYYYY
# SENTRY_ENVIRONMENT=production  # tanımsızsa APP_ENV'den alınır
# SENTRY_RELEASE=lostick-ai@1.0.0  # CI/CD'de git SHA verebilirsiniz
# SENTRY_TRACES_SAMPLE_RATE=0.1  # %10 istek APM traces gönderir (0.0 = APM kapalı)
# SENTRY_SEND_PII=false  # KVKK için default false (kullanıcı IP'si gönderilmez)
